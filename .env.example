# Required: set a long unique password before running in any shared environment.
DASHBOARD_PASSWORD=replace-this-with-a-long-random-password
SESSION_SECRET=replace-this-with-at-least-32-random-characters
PORT=3000
HOST=127.0.0.1

# Set COOKIE_SECURE=true only when served over HTTPS.
COOKIE_SECURE=false

# Optional STUN/TURN configuration. TURN credentials must be temporary/short-lived
# in production; never publish a static TURN secret in frontend JavaScript.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
