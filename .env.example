
# Dashboard security
DASHBOARD_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Server
PORT=3000
HOST=0.0.0.0

# Cookie security
# auto = secure cookies automatically in production
COOKIE_SECURE=auto

# Persistent storage
DATA_DIR=./data

# WebRTC STUN/TURN configuration
STUN_URL=stun:stun.l.google.com:19302

# Optional TURN server
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
